    "autoprefixer": "^10.6.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.6",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.49",
